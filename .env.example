# Copy this file to .env and fill in your own keys.
# Never commit the real .env file — it's already in .gitignore.

# Unsplash API — free, no credit card. Used only by collect_dataset.py
# to download the source image dataset. Get one at:
# https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Gemini API — free tier, no credit card. Used by run_batch.py to tag
# images (category, caption, confidence). Get one at:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Everything after tagging (embeddings, matching, the review API, eval)
# runs fully locally — no additional keys needed.
